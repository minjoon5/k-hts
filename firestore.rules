rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙 탭에 그대로 붙여넣고 [게시]하세요.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // index.html 의 ADMIN_EMAIL 과 같아야 합니다.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'kimminjoon1205@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validNickname(n) {
      return n is string && n.size() >= 1 && n.size() <= 20;
    }

    match /nicknames/{name} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.nickname == name;

      allow update: if false;

      // 관리자가 계좌를 삭제할 때 닉네임도 함께 지웁니다.
      allow delete: if isAdmin();
    }

    match /accounts/{uid} {
      allow read: if true;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'cash', 'holdings', 'createdAt', 'updatedAt'])
        && validNickname(request.resource.data.nickname)
        && request.resource.data.cash == 50000000
        && request.resource.data.holdings is map
        && request.resource.data.holdings.size() == 0
        && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.nickname)).data.uid == uid;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cash', 'holdings', 'updatedAt'])
        && request.resource.data.cash is number
        && request.resource.data.cash >= 0
        && request.resource.data.holdings is map
        && request.resource.data.holdings.keys().hasOnly(['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J']);

      // 관리자 초기화: 현금 5,000만 원, 보유 주식 없음으로만 되돌릴 수 있습니다.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cash', 'holdings', 'updatedAt'])
        && request.resource.data.cash == 50000000
        && request.resource.data.holdings is map
        && request.resource.data.holdings.size() == 0;

      // 관리자 삭제
      allow delete: if isAdmin();
    }

    // 업데이트 알림은 관리자만 보낼 수 있습니다.
    match /system/config {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.version == 2
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 100;

      allow update: if isAdmin()
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 100;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
